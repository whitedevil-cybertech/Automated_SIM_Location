# ==============================================================================
# IFSO Location Request Management System - Environment Configuration
# ==============================================================================
# NOTE: Copy this file to .env for local development. Never commit .env to git.

# Application Configuration
APP_ENV=development
APP_NAME=IFSO Location Request Management System
APP_DEBUG=true
LOG_LEVEL=INFO

# API Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# MongoDB Configuration
# Local development safe default; credentials must be provided via environment variables
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ifso_location_dev
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=3000

# Security Configuration
# Generate a secure random key for actual development/testing: openssl rand -hex 32
SECRET_KEY=insecure-dev-key-change-in-production-only-for-local-testing
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Development-only static bearer-token auth is rejected outside development/testing.
# Production/staging must use AUTH_MODE=external with a real identity-provider integration.
AUTH_MODE=development_static
# JSON map of token -> principal_id:ROLE, for local development/testing only.
DEVELOPMENT_AUTH_TOKENS={"dev-officer-token":"OFFICER-DEV-001:OFFICER","dev-io-token":"IO-DEV-001:IO","dev-admin-token":"ADMIN-DEV-001:ADMIN"}
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside development/testing. Development/testing derive a local-only key from SECRET_KEY if omitted.
FIELD_ENCRYPTION_KEY=

# Operational Configuration
REQUEST_TOKEN_EXPIRE_HOURS=24
SMS_TIMEOUT_MINUTES=5
MAX_SMS_RETRIES=2
