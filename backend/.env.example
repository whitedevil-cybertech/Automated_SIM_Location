# ==============================================================================
# IFSO Location Request Management System - Environment Configuration
# ==============================================================================
# NOTE: Copy this file to .env for local development. Never commit .env to git.

# Application Configuration
APP_ENV=development
APP_NAME=IFSO Location Request Management System
APP_DEBUG=true
LOG_LEVEL=INFO

# API Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Never commit real credentials. Configure a dedicated PostgreSQL role.
DATABASE_URL=postgresql+psycopg://ifso_app:Amit01@localhost:5432/ifso_location
DATABASE_NAME=ifso_location
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=3
APP_ENV=development
APP_DEBUG=false

# Security Configuration
# Generate a secure random key for actual development/testing: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-local-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Development-only static bearer-token auth is rejected outside development/testing.
# Production/staging must use AUTH_MODE=external with a real identity-provider integration.
AUTH_MODE=development_static
# JSON map of token -> principal_id:ROLE, for local development/testing only.
DEVELOPMENT_AUTH_TOKENS={}
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside development/testing. Development/testing derive a local-only key from SECRET_KEY if omitted.
FIELD_ENCRYPTION_KEY=

# Operational Configuration
REQUEST_TOKEN_EXPIRE_HOURS=24
SMS_TIMEOUT_MINUTES=5
MAX_SMS_RETRIES=2
